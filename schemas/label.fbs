namespace labios.schema;

enum LabelType : byte { Read, Write, Delete, Flush, Composite, Observe }
enum CompletionStatus : byte { Complete, Error }
enum HazardType : byte { RAW, WAW, WAR, Order, Barrier }
enum Intent : byte {
    None, Checkpoint, Cache, ToolOutput, FinalResult,
    Intermediate, SharedState,
    Embedding, ModelWeight, KVCache, ReasoningTrace
}
enum Isolation : byte { None, Agent, Workspace, Global }
enum Durability : byte { Ephemeral, Durable }
enum StatusCode : byte { Created, Queued, Shuffled, Scheduled, Executing, Complete, Failed }
enum ContinuationKind : byte { None, Notify, Chain, Conditional }
enum ResourceFamily : byte { FileRange, Memory, Network, KeyValue, Relational, Object, Vector, Graph, Channel, Workspace, Extension }
enum BindingProvenance : byte { DirectProducer, MaterializedSource }

union PointerVariant { MemoryPtr, FilePath, NetworkEndpoint }

table MemoryPtr {
  address: uint64;
  size:    uint64;
}

table FilePath {
  path:   string;
  offset: uint64;
  length: uint64;
}

table NetworkEndpoint {
  host: string;
  port: uint16;
}

table FileRangeResource { backend_id: string; namespace: string; path: string; offset: ulong; length: ulong; extent: string; }
table MemoryResource { owner: string; allocation_id: string; offset: ulong; length: ulong; transfer_token: string; }
table NetworkResource { backend_id: string; transport: string; host: string; port: uint16; stream: string; }
table KeyValueResource { backend_id: string; database: string; namespace: string; key: string; }
table RelationalResource { backend_id: string; database: string; schema: string; relation: string; selector: string; }
table ObjectResource { backend_id: string; bucket: string; key: string; offset: ulong; length: ulong; extent: string; }
table VectorResource { backend_id: string; database: string; collection: string; item_id: string; }
table GraphResource { backend_id: string; database: string; graph: string; element_id: string; }
table ChannelResource { namespace: string; name: string; sequence_start: ulong; sequence_count: ulong; }
table WorkspaceResource { namespace: string; name: string; entry_key: string; }
table ExtensionResource { namespace: string; kind: string; schema_version: uint; identity: [ubyte]; address: [ubyte]; }
union ResourceValue { FileRangeResource, MemoryResource, NetworkResource, KeyValueResource, RelationalResource, ObjectResource, VectorResource, GraphResource, ChannelResource, WorkspaceResource, ExtensionResource }
table VersionConstraint { relation: ubyte; token: string; }
table ResourceRef { backend_id: string; logical_id: string; version_constraint: VersionConstraint; value: ResourceValue; }
table StagedInputBinding { provenance: BindingProvenance; content_id: string; logical_length: ulong; digest_algorithm: string; digest: [ubyte]; observed_version: string; }

table Pointer {
  ptr: PointerVariant;
}

table LabelDependency {
  label_id:    uint64;
  hazard_type: HazardType;
}

table Continuation {
  kind:           ContinuationKind;
  target_channel: string;
  chain_params:   string;
  condition:      string;
}

table RoutingDecision {
  worker_id:  uint32;
  policy:     string;
}

table HopRecord {
  component:    string;
  timestamp_us: uint64;
}

table AggregationInfo {
  original_ids:    [uint64];
  merged_offset:   uint64;
  merged_length:   uint64;
}

table ScoreComponent {
  metric: string;
  raw_value: double;
  normalized_value: double;
  weight: double;
  contribution: double;
}

enum SchedulingDemandBasis : ubyte {
  Unknown = 0,
  ReservationBytes = 1,
  UnitCount = 2
}

table RoundRobinEvidence {
  cursor_worker_id_before: int;
  selected_scan_rank: uint;
}

table RandomEvidence {
  batch_seed: ulong;
  raw_draw: ulong;
  candidate_count: uint;
  selected_index: uint;
}

table ConstraintEvidence {
  profile_name: string;
  profile_version: uint;
}

table MinMaxWorkerEvidence {
  worker_id: int;
  profit: double;
  target_share: double;
  target_amount: double;
  consumption_before: double;
  consumption_after: double;
  spill_rank: uint;
}

table MinMaxEvidence {
  demand_basis: SchedulingDemandBasis;
  total_demand: ulong;
  final_batch_objective: double;
  worker_evidence: [MinMaxWorkerEvidence];
  profile_name: string;
  profile_version: uint;
  cold_exploration: bool;
}

union StructuredPolicyEvidence {
  RoundRobinEvidence,
  RandomEvidence,
  ConstraintEvidence,
  MinMaxEvidence
}

enum SchedulingDemandKind : ubyte {
  Exact = 0,
  LowerBound = 1,
  Unknown = 2
}

table ReplayResourceRequirement {
  family: ubyte;
  backend_id: string;
  scheme: string;
  identity: string;
  locality_domain: string;
  hard_locality: bool;
}

table ReplayJobDescriptor {
  unit_id: ulong;
  label_id: ulong;
  ordinal: ulong;
  label_type: LabelType;
  operation: string;
  operation_version: uint;
  ir_version: uint;
  minimum_tier: ubyte;
  pipeline_operations: [string];
  pipeline_operation_versions: [uint];
  sources: [ReplayResourceRequirement];
  destinations: [ReplayResourceRequirement];
  demand_bytes: ulong;
  demand_kind: SchedulingDemandKind;
  intent: Intent;
  priority: ubyte;
  ready: bool;
}

table ReplaySchedulingUnit {
  unit_id: ulong;
  ordinal: ulong;
  members: [ReplayJobDescriptor];
  ready: bool;
  predecessors: [ulong];
}

table ReplayWorkerAttachment {
  family: ubyte;
  backend_id: string;
  scheme: string;
  locality_kind: ubyte;
  locality_domain: string;
}

table ReplayTraceScheme {
  scheme: string;
  throughput: double;
}

table ReplayWorkerSnapshot {
  worker_id: int;
  available: bool;
  capacity: double;
  load: double;
  speed: int;
  energy: int;
  tier: ubyte;
  skills: double;
  compute: double;
  reasoning: int;
  registration_epoch: ulong;
  total_capacity_bytes: ulong;
  available_capacity_bytes: ulong;
  max_ir_version: uint;
  operations: [string];
  operation_versions: [uint];
  pipeline_operations: [string];
  pipeline_operation_versions: [uint];
  attachments: [ReplayWorkerAttachment];
  locality_domains: [string];
  trace_samples: ulong;
  trace_service_us: double;
  trace_queue_depth: double;
  trace_throughput_bytes_per_sec: double;
  trace_scheme_throughput: [ReplayTraceScheme];
}

table ReplayWeightProfile {
  name: string;
  availability: double;
  capacity: double;
  load: double;
  speed: double;
  energy: double;
  tier: double;
  skills: double;
  compute: double;
  reasoning: double;
  trace_service: double;
  trace_queue: double;
  trace_throughput: double;
  trace_cold_start: double;
  trace_queue_anchor: double;
  trace_min_samples: ulong;
}

table CandidateEvaluation {
  worker_id: int;
  feasible: bool;
  reason_codes: [string];
  available_capacity_before: ulong;
  available_capacity_after: ulong;
  locality_match: bool;
  score_components: [ScoreComponent];
  final_objective: double;
  policy_rank: uint;
  selected: bool;
  trace_sample_count: ulong;
  trace_service_anchor: double;
  trace_queue_anchor: double;
  trace_throughput_anchor: double;
}

table SchedulingDecisionSnapshot {
  decision_id: ulong;
  batch_id: ulong;
  scheduling_unit_id: ulong;
  attempt: uint;
  registry_generation: ulong;
  job_ordinal: ulong;
  outcome: string;
  chosen_worker_id: int;
  park_reason: string;
  reservation_bytes: ulong;
  complete_size_known: bool;
  candidates: [CandidateEvaluation];
  policy_name: string;
  policy_evidence: string;
  policy_version: uint;
  tie_break: string;
  structured_policy: StructuredPolicyEvidence;
  replay_unit: ReplaySchedulingUnit;
  replay_workers: [ReplayWorkerSnapshot];
  replay_profile: ReplayWeightProfile;
}

table ScoreSnapshot {
  availability: double;
  capacity:     double;
  load:         double;
  speed:        double;
  energy:       double;
  tier:         double;
  decision_version: uint;
  decisions: [SchedulingDecisionSnapshot];
}

table LabelResult {
  data_location:    string;
  error:            string;
  bytes_transferred: uint64;
}

table Label {
  // === Origin fields ===
  id:           uint64;
  type:         LabelType;
  source:       Pointer;
  destination:  Pointer;
  operation:    string;
  flags:        uint32;
  priority:     uint8;
  app_id:       uint32;
  data_size:    uint64;
  intent:       Intent;
  ttl_seconds:  uint32;
  isolation:    Isolation;
  reply_to:     string;
  file_key:     string;
  version:      uint64;
  durability:   Durability;
  continuation: Continuation;
  source_uri:     string;
  dest_uri:       string;
  pipeline_data:  string;

  // === Accumulation fields (written by runtime components) ===
  dependencies:   [LabelDependency];
  children:       [uint64];
  routing:        RoutingDecision;
  supertask_id:   uint64;
  aggregation:    AggregationInfo;
  score_snapshot: ScoreSnapshot;
  hops:           [HopRecord];

  // === State fields ===
  status:         StatusCode;
  created_us:     uint64;
  queued_us:      uint64;
  dispatched_us:  uint64;
  started_us:     uint64;
  completed_us:   uint64;
  result:         LabelResult;

  // Versioned Label I/O semantic IR. Appended for backwards-compatible parsing.
  ir_version:     uint;
  operation_version: uint;
  source_resource: ResourceRef;
  destination_resource: ResourceRef;
  declared_dependencies: [uint64];
  input_binding: StagedInputBinding;
}

table Completion {
  label_id: uint64;
  status:   CompletionStatus;
  error:    string;
  data_key: string;
}

root_type Label;
